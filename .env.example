# Control plane (this repository / deployed Wingman API)
DATABASE_URL=postgres://wingman:wingman@localhost:5432/wingman
INNGEST_EVENT_KEY=
INNGEST_SIGNING_KEY=
OPENAI_API_KEY=
CODEX_APP_SERVER_ENDPOINT=
CODEX_APP_SERVER_TOKEN=
WINGMAN_API_URL=http://localhost:3000
WINGMAN_API_KEY=
WINGMAN_RUNTIME=production
WINGMAN_ORG_ID=
WINGMAN_ORG_SALT=
WINGMAN_SIGNING_KEY=
WINGMAN_AGENT_ID=
WINGMAN_OPERATOR_USER_HASH=
WINGMAN_OPERATOR_USERNAME=
WINGMAN_OPERATOR_PASSWORD=
WINGMAN_RUNNER_ENDPOINT=
WINGMAN_RUNNER_TOKEN=
WINGMAN_MAX_EXPECTATION_MS=1500
WINGMAN_MAX_LIVE_TURN_MS=2500
WINGMAN_MAX_TOOL_REVIEW_MS=1000
WINGMAN_EXPECTATION_MODEL=gpt-5.4-mini
WINGMAN_ASSERTION_MODEL=gpt-5.4-mini
WINGMAN_GATE_MODEL=gpt-5.4-mini
WINGMAN_REVIEW_MODEL=gpt-5.4-mini
WINGMAN_EMBEDDING_MODEL=text-embedding-3-small
WINGMAN_FIX_MODEL=
WINGMAN_BASE_CONFIG=

# Agent host (set these in the process that installs @wingman/sdk).
# WINGMAN_URL is the control-plane origin the SDK calls. Locally it is the same
# value as WINGMAN_API_URL; in production it is your deployed Wingman HTTPS URL.
WINGMAN_URL=http://localhost:3000
