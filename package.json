{
  "name": "wingman",
  "private": true,
  "description": "Decision review and outcome verification for tool-using AI agents.",
  "type": "module",
  "packageManager": "pnpm@10.30.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/zkortam/wingman.git"
  },
  "homepage": "https://github.com/zkortam/wingman#readme",
  "bugs": "https://github.com/zkortam/wingman/issues",
  "license": "MIT",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "pnpm -r --if-present build",
    "check": "pnpm format:check && pnpm typecheck && pnpm lint && pnpm boundaries && pnpm contrast && pnpm ui-policy && pnpm test && pnpm test:pipeline && pnpm build && pnpm package:check",
    "typecheck": "pnpm -r --if-present typecheck",
    "lint": "eslint . --max-warnings=0",
    "boundaries": "node scripts/check-boundaries.ts && node scripts/run-dependency-cruiser.ts",
    "contrast": "node scripts/check-contrast.ts",
    "ui-policy": "node scripts/check-ui-policy.ts",
    "test": "vitest run --config vitest.config.ts",
    "test:pipeline": "vitest run --config vitest.config.ts --project pipeline --project pipeline-fixtures",
    "package:check": "node scripts/check-sdk-package.ts",
    "bootstrap-config": "pnpm --filter @wingman/schema build && node scripts/bootstrap-config.ts",
    "dev": "pnpm --filter @wingman/web dev",
    "demo:reset": "node fixtures/src/reset.ts",
    "demo:up": "node scripts/demo-up.ts",
    "fixtures:generate": "node fixtures/src/generate.ts",
    "demo": "pnpm --filter @demo/host start",
    "coverage": "vitest run --config vitest.config.ts --coverage",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "db:up": "docker compose up -d --wait",
    "db:down": "docker compose down -v",
    "db:migrate": "node scripts/db-migrate.ts",
    "test:db": "vitest run --config vitest.db.config.ts"
  },
  "devDependencies": {
    "@eslint/js": "9.39.2",
    "@types/node": "20.19.30",
    "@vitest/coverage-v8": "4.1.9",
    "dependency-cruiser": "18.2.0",
    "eslint": "9.39.2",
    "prettier": "3.6.2",
    "typescript": "5.9.3",
    "typescript-eslint": "8.54.0",
    "vitest": "4.1.9"
  }
}
