{
  "name": "outcome",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.30.0",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "pnpm -r --if-present build",
    "check": "pnpm typecheck && pnpm lint && pnpm boundaries && pnpm contrast && pnpm ui-policy && pnpm test && pnpm test:pipeline",
    "typecheck": "pnpm -r --if-present typecheck",
    "lint": "eslint . --max-warnings=0",
    "boundaries": "node scripts/check-boundaries.ts && node scripts/run-dependency-cruiser.ts",
    "contrast": "node scripts/check-contrast.ts",
    "ui-policy": "node scripts/check-ui-policy.ts",
    "test": "vitest run --config vitest.config.ts",
    "test:pipeline": "vitest run --config vitest.config.ts --project pipeline",
    "dev": "pnpm --filter @outcome/web dev",
    "demo:reset": "node fixtures/src/reset.ts",
    "demo:up": "node scripts/demo-up.ts",
    "fixtures:generate": "node fixtures/src/generate.ts"
  },
  "devDependencies": {
    "@eslint/js": "9.39.2",
    "@types/node": "20.19.30",
    "dependency-cruiser": "18.2.0",
    "eslint": "9.39.2",
    "typescript": "5.9.3",
    "typescript-eslint": "8.54.0",
    "vitest": "4.1.9"
  }
}
