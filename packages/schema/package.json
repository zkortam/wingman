{
  "name": "@wingman/schema",
  "version": "0.1.1",
  "description": "Runtime-validated contracts and frozen ports for Wingman agent integrations.",
  "keywords": [
    "ai-agents",
    "zod",
    "tool-calling",
    "contracts"
  ],
  "type": "module",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/zkortam/wingman.git",
    "directory": "packages/schema"
  },
  "homepage": "https://github.com/zkortam/wingman#readme",
  "bugs": "https://github.com/zkortam/wingman/issues",
  "sideEffects": false,
  "exports": {
    ".": "./src/index.ts",
    "./contracts": "./src/ports.contract.ts"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json",
    "test": "vitest run"
  },
  "dependencies": {
    "zod": "^3.24.0"
  },
  "devDependencies": {
    "vitest": "4.1.9"
  },
  "peerDependencies": {
    "vitest": ">=4"
  },
  "peerDependenciesMeta": {
    "vitest": {
      "optional": true
    }
  },
  "engines": {
    "node": ">=22"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "publishConfig": {
    "access": "public",
    "main": "./dist/index.js",
    "types": "./dist/index.d.ts",
    "exports": {
      ".": {
        "types": "./dist/index.d.ts",
        "import": "./dist/index.js"
      },
      "./contracts": {
        "types": "./dist/ports.contract.d.ts",
        "import": "./dist/ports.contract.js"
      }
    }
  }
}
